# ==========================================================================
# Copia este archivo a backend/.env y ajusta los valores.
# NUNCA subas backend/.env al repositorio.
# ==========================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (formato URL) ---
DATABASE_URL=postgres://postgres:cambia-esta-contrasena@localhost:5432/la_gran_cosecha
DB_CONN_MAX_AGE=600

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# --- CORS / CSRF (orígenes de los frontends React) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Correo OTP ---
# En desarrollo puedes dejar el backend de consola (imprime el correo en la terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Seguridad La Gran Cosecha <no-reply@lagrancosecha.local>

# --- OTP ---
OTP_EXPIRY_MINUTES=10
