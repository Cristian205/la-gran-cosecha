# ==========================================================================
# Copia este archivo a backend/.env y ajusta los valores.
# NUNCA subas backend/.env al repositorio.
# ==========================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (formato URL) ---
# Con Supabase usa siempre el host del pooler en session mode (puerto 5432).
# El host directo db.<ref>.supabase.co solo tiene IPv6 y falla en redes sin IPv6;
# el puerto 6543 (transaction mode) obliga a CONN_MAX_AGE=0, y base.py lo fuerza.
DATABASE_URL=postgres://postgres:cambia-esta-contrasena@localhost:5432/la_gran_cosecha
# Conexion directa. Django no la lee; solo la usan las migraciones de Prisma.
DIRECT_URL=
# 0 = cerrar al terminar cada peticion. En desarrollo dejalo en 0: el pooler de
# Supabase solo da 15 huecos y runserver los agota si los mantiene abiertos.
DB_CONN_MAX_AGE=0

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# --- CORS / CSRF (origenes de los frontends React) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Correo OTP ---
# En desarrollo puedes dejar el backend de consola (imprime el correo en la terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Con Gmail, DEFAULT_FROM_EMAIL debe usar la MISMA direccion que EMAIL_HOST_USER
# o el servidor rechaza el remitente.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Seguridad La Gran Cosecha <cambia@example.com>

# --- Brevo (envio del correo OTP por API HTTPS) ---
# Render bloquea los puertos SMTP salientes en las instancias free, asi que en
# produccion el correo NO puede salir por smtp.gmail.com. Con esta clave puesta,
# prod.py usa la API de Brevo (puerto 443). Sin ella se cae a SMTP.
# Se obtiene en Brevo > SMTP & API > API Keys. La direccion de EMAIL_HOST_USER
# tiene que estar verificada como remitente en Brevo > Senders.
BREVO_API_KEY=

# --- OTP ---
OTP_EXPIRY_MINUTES=10

# --- Cloudflare R2 (archivos subidos) ---
# Si estas cuatro estan puestas, media se guarda en R2. Si falta alguna, se
# guarda en disco local (que es lo normal en desarrollo).
# Se obtienen en Cloudflare > R2 > Manage API Tokens (token de Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Dominio publico del bucket: el subdominio r2.dev que se activa en
# Settings > Public Development URL, o un dominio propio conectado al bucket.
# Sin el, Django tiene que firmar cada URL y las imagenes caducan.
R2_PUBLIC_URL=
# Prefijo dentro del bucket. No cambiarlo sin mover tambien los archivos: las
# rutas guardadas en la base de datos cuelgan de el.
R2_LOCATION=media
