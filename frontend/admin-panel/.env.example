# URL base de la API del backend Django.
#
# Desarrollo: dejar "/api". Vite hace proxy de /api al backend en localhost:8000
# (ver vite.config.ts), asi que no hay CORS.
VITE_API_URL=/api

# Produccion (Vercel): NO se usa este archivo. Hay que definir VITE_API_URL en
# Settings > Environment Variables del proyecto, con la URL ABSOLUTA y publica
# del backend, incluyendo /api. Ejemplo:
#   VITE_API_URL=https://api.lagrancosecha.com/api
#
# Vite incrusta las VITE_* en el bundle EN TIEMPO DE BUILD: si cambias el valor
# en Vercel hay que volver a desplegar para que surta efecto.
#
# Nunca pongas secretos en variables VITE_*: acaban en el JavaScript publico.
