# Número de WhatsApp comercial de Crafteech, con indicativo de país (ej. 573001234567).
# Sin definir, los botones de WhatsApp no se pintan.
VITE_WHATSAPP_NUMERO=

# URL base del backend de la plataforma, donde el formulario guarda las solicitudes
# (ej. https://api.crafteech.com). Sin definir usa el mismo origen: en desarrollo,
# el proxy de Vite envía /api a http://localhost:8000.
VITE_API_URL=
