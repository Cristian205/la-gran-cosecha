# URL del backend Django, desde el servidor de Next (no desde el navegador).
API_URL=http://localhost:8000/api

# Clave compartida con Django (TENANCY_CLAVE_SERVIDOR en el backend).
# Es lo que acredita que la llamada viene de este servidor y no de un
# navegador. NUNCA con prefijo NEXT_PUBLIC_: eso la incrustaria en el paquete
# que descarga el cliente y cualquiera podria pedir el catalogo de cualquier
# negocio.
TENANCY_CLAVE_SERVIDOR=cambia-esta-clave

# Dominio de la plataforma: <slug>.plataforma.com identifica al negocio.
DOMINIO_PLATAFORMA=plataforma.com

# Segundos que se cachea una respuesta del catalogo.
REVALIDAR_SEGUNDOS=60

# Host del bucket publico de R2, para que next/image acepte las imagenes.
NEXT_PUBLIC_MEDIA_HOST=
